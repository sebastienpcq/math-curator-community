  "exercises": [
    {
      "id": "ex-arithmetic",
      "skillId": "arithmetic",
      "type": "numeric",
      "question": "Combien vaut 8 × 7 ?",
      "answer": 56,
      "tolerance": 0,
      "explanation": "8 × 7 = 56."
    },
    {
      "id": "ex-fractions",
      "skillId": "fractions",
      "type": "numeric",
      "question": "Combien vaut 1/2 + 1/4 ? Réponds en décimal.",
      "answer": 0.75,
      "tolerance": 0,
      "explanation": "1/2 = 0,5 et 1/4 = 0,25, donc 0,75."
    },
    {
      "id": "ex-powers",
      "skillId": "powers",
      "type": "numeric",
      "question": "Combien vaut 2 puissance 5 ?",
      "answer": 32,
      "tolerance": 0,
      "explanation": "2 × 2 × 2 × 2 × 2 = 32."
    },
    {
      "id": "ex-symbols",
      "skillId": "symbols",
      "type": "numeric",
      "question": "Pour x = 3, combien vaut 2x + 5 ?",
      "answer": 11,
      "tolerance": 0,
      "explanation": "2 × 3 + 5 = 11."
    },
    {
      "id": "ex-equations",
      "skillId": "equations",
      "type": "numeric",
      "question": "Résous 3x + 2 = 14 : quelle valeur de x ?",
      "answer": 4,
      "tolerance": 0,
      "explanation": "3x = 12, donc x = 4."
    },
    {
      "id": "ex-functions",
      "skillId": "functions",
      "type": "numeric",
      "question": "Si f(x) = 2x - 1, combien vaut f(5) ?",
      "answer": 9,
      "tolerance": 0,
      "explanation": "f(5) = 10 - 1 = 9."
    },
    {
      "id": "ex-logarithms",
      "skillId": "logarithms",
      "type": "numeric",
      "question": "Combien vaut log10(1000) ?",
      "answer": 3,
      "tolerance": 0,
      "explanation": "10³ = 1000, donc log10(1000) = 3."
    }
  ]
